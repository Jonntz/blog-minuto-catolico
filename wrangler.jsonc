{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "minuto-catolico",
	"main": ".open-next/worker.js",
	"compatibility_date": "2026-07-27",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	// NOTA: não há "triggers.crons" aqui de propósito.
	// O worker gerado pelo OpenNext exporta apenas `fetch` — não tem handler
	// `scheduled`, então um Cron Trigger apontado para cá dispararia no vazio.
	// O agendamento vive em workers/scheduler/, que chama /api/cron/* por HTTP
	// com o CRON_SECRET. Ver MEMORY.md §2.7.
	//
	// UM banco, UM binding (`DB`). Havia aqui uma segunda entrada duplicada
	// (binding `minuto_eclesiastico`, `remote: true`) apontando para o mesmo
	// database_id — removida: `remote: true` força ida à rede mesmo em
	// desenvolvimento local, e dois bindings para o mesmo banco só criam
	// ambiguidade sobre qual o código usa.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "minuto-eclesiastico",
			"database_id": "be66eecd-f2e1-48ac-9f47-19b0b0f6acb4",
			"migrations_dir": "drizzle/migrations"
		},
		// Tag cache do OpenNext. Banco SEPARADO do da aplicação, de propósito:
		// o adapter cria e gerencia a própria tabela de revalidações, e ela não
		// deve morar no schema que o Drizzle controla — um `drizzle-kit push`
		// distraído poderia derrubá-la. Também evita contenção de escrita com a
		// ingestão. Ver open-next.config.ts.
		//
		// ⚠️ Criar antes do primeiro deploy:
		//   npx wrangler d1 create minuto-eclesiastico-cache
		// e colar o id devolvido aqui.
		{
			"binding": "NEXT_TAG_CACHE_D1",
			"database_name": "minuto-eclesiastico-cache",
			"database_id": "47f55bb6-cf1f-4a6f-b82a-a11d640f61c1"
		}
	],
	// Cache incremental do OpenNext (`"use cache"` + cacheLife).
	//
	// KV e não R2: ativar o R2 exige método de pagamento mesmo no tier gratuito
	// (foi por isso que o binding MEDIA saiu daqui), enquanto KV é gratuito sem
	// cartão. Sem este binding, os perfis de cacheLife do next.config.ts e todo
	// o revalidate.ts ficam sem store durável e cada isolate frio refaz as
	// consultas no D1.
	//
	// ⚠️ Criar antes do primeiro deploy:
	//   npx wrangler kv namespace create NEXT_INC_CACHE_KV
	"kv_namespaces": [
		{
			"binding": "NEXT_INC_CACHE_KV",
			"id": "9f8ec88137174d95ba4f85404ce750df"
		}
	],
	// R2 (binding MEDIA) REMOVIDO por ora.
	//
	// Motivo: nada no código usa `env.MEDIA`, o OpenNext roda com cache padrão
	// (não em R2), e as imagens são servidas direto dos CDNs das fontes via
	// `next/image` (ver `remotePatterns` em next.config.ts). Manter o binding
	// obrigaria a ativar o R2 no painel — que pede método de pagamento mesmo no
	// tier gratuito — para um recurso que ninguém chama.
	//
	// Quando reativar: no momento em que passarmos a re-hospedar as imagens em
	// vez de apontar para o CDN de terceiro. É desejável (o CLAUDE.md §2 prevê
	// R2, e hoje consumimos a banda do Cloudinary do EWTN), mas é trabalho novo,
	// não pré-requisito para publicar.
	//
	// "r2_buckets": [
	//   { "binding": "MEDIA", "bucket_name": "minuto-eclesiastico-media" }
	// ],
	//
	// Workers AI — hoje é PROVIDER DE RESERVA, não o padrão.
	//
	// O padrão passou a ser a NVIDIA (TRANSLATION_PROVIDER=nvidia), porque a
	// cota de 10.000 Neurons/dia comporta ~34 artigos e as fontes produzem ~75:
	// a fila nascia represada e o lote abortava por `quota` todo dia. Ver
	// src/services/translation/nvidia.ts.
	//
	// O binding fica: é gratuito, não custa nada estar declarado, e é o caminho
	// de volta imediato (basta trocar a var abaixo) se a NVIDIA sair do ar.
	"ai": {
		"binding": "AI"
	},
	"observability": {
		"enabled": true
	},
	"vars": {
		"SITE_URL": "https://minutocatolico.com.br",
		"SOURCE_SOTC_ENABLED": "true",
		// Provider de adaptação: "nvidia" (padrão), "workersAi" (reserva) ou
		// "anthropic" (stub que falha alto).
		"TRANSLATION_PROVIDER": "nvidia",
		// Modelos da NVIDIA: apelido de MODELOS_NVIDIA ou id completo
		// "vendor/modelo". Adaptação e verificação são de FAMÍLIAS DIFERENTES de
		// propósito — um Llama auditando o que um Nemotron escreveu não herda os
		// vícios do autor, que é o que se quer de uma checagem adversarial.
		// Bônus: o limite gratuito (~40 req/min) é POR MODELO, então dois
		// modelos distintos também dobram a vazão.
		"NVIDIA_MODEL": "nemotronSuper",
		"NVIDIA_VERIFY_MODEL": "llama70b",
		// Modelos do Workers AI — só entram em uso com TRANSLATION_PROVIDER=workersAi.
		// Apelido de MODELOS_AVALIADOS ou id completo "@cf/...".
		"WORKERS_AI_MODEL": "llama70b",
		"WORKERS_AI_VERIFY_MODEL": "mistral24b"
	}
	// Segredos (NUNCA em vars):
	//   wrangler secret put CRON_SECRET
	//   wrangler secret put NVIDIA_API_KEY   <- chave gratuita de build.nvidia.com
	// Em desenvolvimento, use .dev.vars (git-ignorado).
}
